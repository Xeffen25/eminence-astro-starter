{
  "name": "eminence-astro-starter",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler types && concurrently \"pnpm paraglide:watch\" \"astro dev\"",
    "build": "pnpm paraglide && astro build",
    "preview": "pnpm build && astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "github:ci": "pnpm format:check && astro check && pnpm test",
    "all": "pnpm format && pnpm cf-typegen && astro check && pnpm test && pnpm build",
    "prepare": "husky",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide",
    "paraglide:watch": "pnpm paraglide --watch",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "lint-staged": {
    "*": "prettier --write"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.6",
    "eminence-astro-suite": "1.0.0-beta.5",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5",
    "svelte": "^5.56.3",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@inlang/cli": "^3.1.12",
    "@inlang/paraglide-js": "^2.19.0",
    "@types/node": "^25.9.3",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
