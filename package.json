{
  "name": "eminence-astro-starter",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "pnpm format:check && astro check && pnpm test",
    "fix": "pnpm format:fix",
    "all": "pnpm format:fix && pnpm cf-typegen && astro check && pnpm build && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.1",
    "eminence-astro-suite": "1.0.0-beta.3",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
